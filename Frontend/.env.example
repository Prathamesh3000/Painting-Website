# Base URL of the backend API, including the /api suffix. Used by the public site and the admin panel.
# Uploaded images are served from the same origin (this URL without /api), e.g. http://localhost:5000/uploads/....
# If unset, the site uses http://localhost:5000/api. If the API is unreachable the public site falls back to its bundled content.
VITE_API_URL=http://localhost:5000/api
